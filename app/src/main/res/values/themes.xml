<resources>

	<style name="AppTheme.PixelXpert" parent="android:Theme.Material.NoActionBar">
		<item name="android:windowBackground">@color/pxn_window_background</item>
		<item name="android:statusBarColor">@android:color/transparent</item>
		<item name="android:navigationBarColor">@android:color/transparent</item>
	</style>

	<style name="AppTheme.PixelXpert.SplashScreen" parent="Theme.SplashScreen">
		<item name="windowSplashScreenBackground">@color/pxn_window_background</item>
		<item name="postSplashScreenTheme">@style/AppTheme.PixelXpert</item>
	</style>
</resources>